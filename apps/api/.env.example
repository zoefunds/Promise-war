# Postgres, direct (not Docker) — a standalone always-on Fly.io Postgres
# machine. Never commit the real value.
DATABASE_URL=postgresql://user:password@localhost:5432/promise_war

# Secret used to sign session JWTs issued after SIWE verification. Generate
# with `openssl rand -hex 32`. Never commit the real value.
SESSION_JWT_SECRET=replace-me-with-a-random-64-char-hex-string

PORT=4000
NODE_ENV=development

# Public — the deployed Intelligent Contract address (mirrors
# apps/web/.env.local's NEXT_PUBLIC_CONTRACT_ADDRESS).
CONTRACT_ADDRESS=0xcbb558b52682d902203d12F94Bd5D0eFC452E581

# How often the background sync poller re-reads claim/evidence state from
# the contract, in milliseconds.
SYNC_INTERVAL_MS=30000

# Origins allowed to call this API (comma-separated). Set to your deployed
# Vercel URL(s) in production.
CORS_ORIGINS=http://localhost:3000
