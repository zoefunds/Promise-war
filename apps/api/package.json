{
  "name": "@promise-war/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema ../../database/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate deploy --schema ../../database/schema.prisma",
    "prisma:generate": "prisma generate --schema ../../database/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "express": "4.21.1",
    "cors": "2.8.5",
    "cookie-parser": "1.4.7",
    "jsonwebtoken": "9.0.2",
    "genlayer-js": "1.1.8",
    "viem": "2.21.19",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/cors": "2.8.17",
    "@types/cookie-parser": "1.4.7",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.16.10",
    "prisma": "5.22.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  }
}
